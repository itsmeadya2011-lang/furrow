# Furrow Configuration
# Copy this file to .env and adjust values as needed.

# LLM provider to use (anthropic, openai, or ollama)
FURROW_PROVIDER=anthropic

# Default LLM model for general tasks
FURROW_MODEL=claude-3-5-sonnet-20241022

# Model used by the planner agent for creating task breakdowns
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022

# Model used by the worker agent for executing tasks
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022

# Model used by the tester agent for validating results
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# Base URL for the Ollama API (only used when FURROW_PROVIDER=ollama)
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Maximum number of tasks to run in parallel
FURROW_MAX_PARALLEL_TASKS=5

# Maximum number of execution cycles (0 = infinite)
FURROW_MAX_CYCLES=0

# Workspace directory for Furrow to operate in (defaults to current directory)
FURROW_WORKSPACE=.

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
FURROW_LOG_LEVEL=INFO

# API key for Anthropic (required when FURROW_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# API key for OpenAI (required when FURROW_PROVIDER=openai)
OPENAI_API_KEY=
