# Furrow environment configuration
# Copy to .env and fill in your values

# LLM provider: "anthropic" or "openai" or "ollama"
FURROW_PROVIDER=anthropic

# Default model used for general completions
FURROW_MODEL=claude-sonnet-4-20250514

# Models for each agent role
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys (only set the one matching your provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama settings (used when FURROW_PROVIDER=ollama)
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Concurrency and loop control
FURROW_MAX_PARALLEL_TASKS=5
FURROW_MAX_CYCLES=0

# Workspace directory for test execution and file operations
FURROW_WORKSPACE=.

# Logging
FURROW_LOG_LEVEL=INFO
