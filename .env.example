# Furrow configuration
# Copy this file to ".env" and adjust values as needed.
# Settings use the FURROW_ env prefix (see furrow/config.py Settings class).

# LLM provider to use: anthropic | openai | ollama
FURROW_PROVIDER=anthropic

# Default LLM model used for general generation
FURROW_MODEL=claude-sonnet-4-20250514

# Model used by the planner agent (breaks work into tasks)
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022

# Model used by the worker agent (executes tasks)
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022

# Model used by the tester agent (runs/verifies tests)
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys (required by the corresponding provider)
# Use FURROW_-prefixed names here — pydantic-settings reads them from .env.
# Alternatively, set ANTHROPIC_API_KEY / OPENAI_API_KEY directly in your
# shell environment; LLMClient falls back to those for convenience.
FURROW_ANTHROPIC_API_KEY=
FURROW_OPENAI_API_KEY=

# Ollama base URL (used when FURROW_PROVIDER=ollama)
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Maximum number of tasks to run in parallel
FURROW_MAX_PARALLEL_TASKS=5

# Maximum number of planning/execution cycles before stopping (0 = unlimited)
FURROW_MAX_CYCLES=0

# Workspace directory for generated files (defaults to the current working directory)
FURROW_WORKSPACE=.

# Log level: DEBUG | INFO | WARNING | ERROR
FURROW_LOG_LEVEL=INFO
