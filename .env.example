# FURROW_ environment variables (all optional; overrides kilo.json / env)
# Example: copy to .env and fill in your values

# LLM provider: anthropic, openai, or ollama
FURROW_PROVIDER=anthropic

# Default model used by the orchestrator-level calls
FURROW_MODEL=claude-sonnet-4-20250514

# Model used by the planner subagent
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022

# Model used by worker subagents
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022

# Model used by the tester subagent
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# Anthropic API key (required when FURROW_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI API key (required when FURROW_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama base URL (used when FURROW_PROVIDER=ollama)
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Maximum number of parallel worker tasks per cycle
FURROW_MAX_PARALLEL_TASKS=5

# Maximum number of cycles (0 = unlimited)
FURROW_MAX_CYCLES=0

# Workspace directory (defaults to current working directory)
FURROW_WORKSPACE=.

# Log level: DEBUG, INFO, WARNING, ERROR
FURROW_LOG_LEVEL=INFO
