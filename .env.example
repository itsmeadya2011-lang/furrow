# Furrow Configuration
# Copy this file to .env and fill in your API keys.

# LLM provider: anthropic, openai, or ollama
FURROW_PROVIDER=anthropic

# Default model (used when no specific model is set)
FURROW_MODEL=claude-sonnet-4-20250514

# Per-agent models (optional, defaults shown)
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys (only required for the chosen provider)
FURROW_ANTHROPIC_API_KEY=
FURROW_OPENAI_API_KEY=

# Ollama settings (used when FURROW_PROVIDER=ollama)
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Execution limits
# Maximum number of parallel worker tasks per cycle
FURROW_MAX_PARALLEL_TASKS=5
# Maximum number of development cycles (0 = unlimited)
FURROW_MAX_CYCLES=0
# Maximum tokens per LLM response
FURROW_MAX_TOKENS=4096

# Workspace directory (defaults to current directory)
FURROW_WORKSPACE=.

# Logging level: DEBUG, INFO, WARNING, ERROR
FURROW_LOG_LEVEL=INFO
