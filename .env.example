# Furrow configuration template
#
# SAFE TO COMMIT -- this file contains placeholders only, never real secrets.
# Copy it to `.env` in the repository root and fill in the values you need:
#
#     cp .env.example .env
#
# Every setting in `furrow.config.Settings` is read from an environment
# variable with the `FURROW_` prefix, or from a `.env` file in the working
# directory. Real environment variables win over `.env` entries.
#
# API key fallback: `furrow/llm.py` also reads `ANTHROPIC_API_KEY` and
# `OPENAI_API_KEY` directly, WITHOUT the `FURROW_` prefix, as a fallback when
# the corresponding `FURROW_*_API_KEY` is not set. Prefer the `FURROW_`-prefixed
# variables below; the unprefixed ones exist for compatibility with the
# conventional SDK environment variables.
#
# `.env` is git-ignored; `.env.example` is tracked.


# ---------------------------------------------------------------------------
# Provider and models
# ---------------------------------------------------------------------------

# Which LLM backend to drive. One of: anthropic | openai | ollama.
FURROW_PROVIDER=anthropic

# Default model for any role that has no explicit override below.
FURROW_MODEL=claude-sonnet-4-20250514

# Model used for the planner role (turns a goal into a task plan).
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022

# Model used for worker agents (implement the tasks).
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022

# Model used for the tester role (runs the test suite, judges pass/fail).
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# NOTE: the four model variables above are auto-defaulted per FURROW_PROVIDER
# (see PROVIDER_MODELS in furrow/config.py) whenever you do not set them
# explicitly, so you can usually leave them commented out.


# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# API key for the anthropic provider. str | None, default: None (unset).
FURROW_ANTHROPIC_API_KEY=sk-ant-placeholder

# API key for the openai provider. str | None, default: None (unset).
FURROW_OPENAI_API_KEY=sk-placeholder

# Base URL of the Ollama server, used when FURROW_PROVIDER=ollama.
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Reminder: ANTHROPIC_API_KEY / OPENAI_API_KEY (no prefix) work as a fallback.


# ---------------------------------------------------------------------------
# Loop control
# ---------------------------------------------------------------------------

# How many tasks may run concurrently. int >= 1, default: 5.
# Values above 20 trigger a runtime warning.
FURROW_MAX_PARALLEL_TASKS=5

# Cycle budget for the loop. int >= 0, default: 0 (0 = no cycle limit).
# 0 does NOT mean "run forever": the loop also terminates on
# request_stop() (Ctrl-C or the web Stop button), when the planner
# returns an empty task list (its signal that the goal is met), or
# after max(3, max_parallel_tasks) consecutive cycles with no
# completed tasks (the stall threshold).
FURROW_MAX_CYCLES=0

# Cap on LLM tool-use rounds inside a single worker. int >= 1, default: 12.
FURROW_WORKER_MAX_ITERATIONS=12


# ---------------------------------------------------------------------------
# Workspace and sandbox
# ---------------------------------------------------------------------------

# Directory the loop operates on. Path, default: current working directory.
FURROW_WORKSPACE=.

# Shell command used to run the test suite.
# str | None, default: None (auto-detected from the project if unset).
FURROW_TEST_COMMAND=pytest -q

# Timeout in seconds for the test command. int >= 1, default: 120.
FURROW_TEST_TIMEOUT=120

# Allow agents to execute shell commands. bool, default: false.
# Enabling this is a security decision -- only enable it in a sandbox.
FURROW_ALLOW_SHELL=false

# Timeout in seconds for a single shell command. int >= 1, default: 60.
FURROW_SHELL_TIMEOUT=60


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log verbosity. str, default: INFO (e.g. DEBUG, INFO, WARNING, ERROR).
FURROW_LOG_LEVEL=INFO

# Emit machine-readable JSON logs instead of human-readable text.
# bool, default: false.
# NOTE: log_json is declared in furrow.config.Settings but referenced
# nowhere else in the codebase -- setting it currently has no effect.
FURROW_LOG_JSON=false
