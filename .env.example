# Furrow environment configuration.
# Copy this file to `.env`, adjust the values as needed, and keep secrets out of
# version control. All settings use the `FURROW_` prefix and are read by
# pydantic-settings (a `.env` file in the working directory is loaded
# automatically).

# --- LLM provider & model overrides ----------------------------------------

# anthropic | openai | ollama
FURROW_PROVIDER=anthropic

# Default model for completions/chat
FURROW_MODEL=claude-sonnet-4-20250514

# Model for the planner
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022

# Model for the worker
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022

# Model for the tester
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys (leave unset for offline providers such as ollama)
FURROW_ANTHROPIC_API_KEY=
FURROW_OPENAI_API_KEY=

# Ollama OpenAI-compatible base URL
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# --- Limits & timeouts -----------------------------------------------------

# Maximum concurrent worker tasks per wave (>= 1)
FURROW_MAX_PARALLEL_TASKS=5

# Maximum cycles to run (0 = unlimited; negative values are rejected)
FURROW_MAX_CYCLES=0

# Maximum tool-call iterations per worker task (>= 1)
FURROW_MAX_WORKER_ITERATIONS=12

# Retry attempts for transient LLM errors (>= 0)
FURROW_MAX_RETRIES=3

# Times a failed task is retried before it is marked failed (>= 0)
FURROW_MAX_TASK_RETRIES=1

# Request timeout in seconds (> 0)
FURROW_REQUEST_TIMEOUT=120.0

# Timeout in seconds for worker/tool commands (> 0)
FURROW_COMMAND_TIMEOUT=300.0

# Timeout in seconds for test suite execution (> 0)
FURROW_TEST_TIMEOUT=600.0

# Max tokens for LLM completions (>= 1)
FURROW_MAX_TOKENS=4096

# --- Logging, state & workspace -------------------------------------------

# Logging level used by the CLI (honoured at startup)
FURROW_LOG_LEVEL=INFO

# State file path (relative to workspace)
FURROW_STATE_FILE=.furrow/state.json

# Working directory for the agent (defaults to current directory)
FURROW_WORKSPACE=

# --- Model pricing ---------------------------------------------------------

# JSON object mapping model ids to {"input_per_million": ..., "output_per_million": ...}
# Example override for a custom model:
# FURROW_MODEL_PRICING='{"my-model":{"input_per_million":1.0,"output_per_million":2.0}}'