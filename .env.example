# Furrow environment configuration
# Copy this file to `.env` and adjust values as needed.
# Furrow reads variables with the `FURROW_` prefix via pydantic-settings.

# ── LLM provider ──────────────────────────────────────────────────────────
# Provider: anthropic, openai, or ollama (default: anthropic)
FURROW_PROVIDER=anthropic

# Default model for completions/chat (default: claude-sonnet-4-20250514)
FURROW_MODEL=claude-sonnet-4-20250514

# Model for the planner (default: claude-3-5-haiku-20241022)
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022

# Model for the worker (default: claude-3-5-sonnet-20241022)
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022

# Model for the tester (default: claude-3-5-sonnet-20241022)
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys (set at least one, depending on provider)
# FURROW_ANTHROPIC_API_KEY=
# FURROW_OPENAI_API_KEY=

# Ollama OpenAI-compatible base URL (default: http://localhost:11434)
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# ── Concurrency and limits ────────────────────────────────────────────────
# Maximum concurrent worker tasks per wave (default: 5, must be >= 1)
FURROW_MAX_PARALLEL_TASKS=5

# Maximum cycles to run (0 = unlimited; negative values are rejected)
FURROW_MAX_CYCLES=0

# Maximum tool-call iterations per worker task (default: 12, must be >= 1)
FURROW_MAX_WORKER_ITERATIONS=12

# Retry attempts for transient LLM errors (default: 3, must be >= 0)
FURROW_MAX_RETRIES=3

# Times a failed task is retried before it is marked failed (default: 1, must be >= 0)
FURROW_MAX_TASK_RETRIES=1

# ── Timeouts ──────────────────────────────────────────────────────────────
# Request timeout in seconds for a single LLM API call (default: 120.0, must be > 0)
FURROW_REQUEST_TIMEOUT=120.0

# Timeout in seconds for worker shell commands (default: 300.0, must be > 0)
FURROW_COMMAND_TIMEOUT=300.0

# Timeout in seconds for the test-suite command (default: 600.0, must be > 0)
FURROW_TEST_TIMEOUT=600.0

# Max tokens for LLM completions (default: 4096, must be >= 1)
FURROW_MAX_TOKENS=4096

# ── Logging ───────────────────────────────────────────────────────────────
# Logging level used by the CLI (honoured at startup; default: INFO)
FURROW_LOG_LEVEL=INFO

# ── State ─────────────────────────────────────────────────────────────────
# State file path relative to the workspace (default: .furrow/state.json)
FURROW_STATE_FILE=.furrow/state.json

# Working directory for the agent (default: current directory)
# FURROW_WORKSPACE=

# ── Cost accounting ───────────────────────────────────────────────────────
# JSON object mapping model ids to {"input_per_million": ..., "output_per_million": ...}
# prices that override the built-in snapshot. Example:
# FURROW_MODEL_PRICING='{"my-model":{"input_per_million":1.0,"output_per_million":2.0}}'
# FURROW_MODEL_PRICING=
