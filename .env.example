# Furrow configuration, all keys are optional (see `.kilo/FURROW.md`).
# Any value can also be passed directly via the `FURROW_` env prefix.

# LLM provider: "anthropic", "openai", or "ollama"
FURROW_PROVIDER=anthropic

# Default model used for general completion.
FURROW_MODEL=claude-sonnet-4-20250514

# Models dedicated to each agent role.
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# Provider API keys (omit the ones you don't use).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama endpoint (only used when FURROW_PROVIDER=ollama).
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Maximum number of tasks planned per cycle (1-5).
FURROW_MAX_PARALLEL_TASKS=5

# Stop the infinite loop after this many cycles (0 = unlimited).
FURROW_MAX_CYCLES=0

# Workspace root the agent operates on (defaults to current directory).
FURROW_WORKSPACE=.

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
FURROW_LOG_LEVEL=INFO
