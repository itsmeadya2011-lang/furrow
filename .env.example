# Furrow environment configuration
# Copy this file to .env and fill in your values.

# LLM provider: anthropic | openai | ollama
FURROW_PROVIDER=anthropic

# Default model used when none is specified per agent
FURROW_MODEL=claude-sonnet-4-20250514

# Per-agent model overrides
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys (only the one for your chosen provider is required)
# FURROW_ANTHROPIC_API_KEY=sk-ant-...
# FURROW_OPENAI_API_KEY=sk-...

# Ollama base URL (only used when FURROW_PROVIDER=ollama)
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Maximum number of parallel tasks per cycle
FURROW_MAX_PARALLEL_TASKS=5

# Maximum number of cycles before halting (0 = unlimited)
FURROW_MAX_CYCLES=0

# Workspace directory where Furrow operates
FURROW_WORKSPACE=.

# Log level
FURROW_LOG_LEVEL=INFO
