# Furrow configuration.
#
# Copy to `.env` and adjust, then run furrow from that directory.
#
# Every variable in the "Settings" block below is read by `furrow.config.Settings`
# through the `FURROW_` env prefix (`env_prefix="FURROW_"` in `furrow/config.py`).
# That block lists one line per field of `Settings`, in declaration order - all 28 of
# them. Anything left out here simply keeps the documented default, so this file is
# reference material, not a requirement.

# ---------------------------------------------------------------------- provider
# Active backend: anthropic | openai | ollama.
FURROW_PROVIDER=anthropic

# Default model, used whenever no per-role model applies.
FURROW_MODEL=claude-sonnet-4-20250514

# Model used by the planner agent (goal -> task breakdown).
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022

# Model used by the worker agents (task execution).
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022

# Model used by the tester agent (verification).
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# --------------------------------------------------------------------- api keys
# Leave blank to fall back to the provider's own variable
# (ANTHROPIC_API_KEY / OPENAI_API_KEY).
FURROW_ANTHROPIC_API_KEY=
FURROW_OPENAI_API_KEY=

# Base URL of the Ollama server; only consulted when provider=ollama.
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# ----------------------------------------------------------------- orchestration
# Concurrent task executions per cycle (enforced with an asyncio.Semaphore).
FURROW_MAX_PARALLEL_TASKS=5

# Planning cycles before the run gives up. 0 means "loop until the goal is met".
FURROW_MAX_CYCLES=0

# Consecutive non-progressing cycles tolerated before the run stops.
FURROW_MAX_STALLED_CYCLES=3

# Directory the agents read and write. Defaults to the current working directory.
FURROW_WORKSPACE=

# File the run's JSON state snapshot is written to after every cycle.
# Unset disables persistence. Resuming a run from this file is NOT implemented;
# there is no --resume flag.
FURROW_STATE_FILE=

# Logging verbosity, e.g. DEBUG | INFO | WARNING | ERROR.
FURROW_LOG_LEVEL=INFO

# ----------------------------------------------------------------- llm requests
# Sampling temperature passed to the provider; 0.0 is deterministic.
FURROW_TEMPERATURE=0.0

# Upper bound on tokens generated per model call.
FURROW_MAX_TOKENS=8192

# Retries after the FIRST attempt, so total attempts = max_retries + 1.
# 0 means "never retry": a transient failure surfaces immediately.
FURROW_MAX_RETRIES=3

# Base delay in seconds for the exponential-jitter backoff between retries.
FURROW_RETRY_BASE_DELAY=1.0

# Per-request timeout in seconds, handed to the provider SDKs.
FURROW_REQUEST_TIMEOUT=120.0

# Per-task tool-use rounds; the worker loop stops (and says so) when exhausted.
FURROW_MAX_TOOL_ITERATIONS=12

# ------------------------------------------------------------------ verification
# Test command. Unset makes the tester auto-detect pytest / npm test.
FURROW_TEST_COMMAND=

# Lint command. Unset makes the tester auto-detect ruff / eslint.
FURROW_LINT_COMMAND=

# Typecheck command. Unset makes the tester auto-detect mypy / tsc.
FURROW_TYPECHECK_COMMAND=

# Seconds a single verification command may run before it is killed.
FURROW_TEST_TIMEOUT=300

# ----------------------------------------------------------------------- tooling
# Directory / glob names the sandboxed tool registry refuses to touch.
# Lists in this file use JSON array syntax.
FURROW_EXCLUDE_DIRS=[".git",".venv","venv","node_modules","__pycache__",".mypy_cache",".ruff_cache",".pytest_cache","dist","build",".eggs","*.egg-info"]

# ------------------------------------------------------------------- web server
# Interface the dashboard binds to.
FURROW_WEB_HOST=127.0.0.1

# Port the dashboard binds to.
FURROW_WEB_PORT=8000

# ------------------------------------------------------------------- observability
# Events retained in the in-memory ring buffer for the web feed.
FURROW_MAX_EVENT_HISTORY=500

# ================================================================================
# NOT a Settings field - read straight from os.getenv in furrow/web/server.py.
#
# The server calls os.getenv("FURROW_WEB_TOKEN") (module constant TOKEN_ENV_VAR),
# so this variable is NOT read through the Settings model above. When it is set to a
# non-empty value every HTTP and websocket request must carry
# "Authorization: Bearer <token>"; when unset or empty, auth is disabled.
# ================================================================================
FURROW_WEB_TOKEN=

# ================================================================================
# Bare API-key fallbacks, also read via os.getenv rather than as Settings fields
# (`Settings.api_key_for`). They apply only when the matching FURROW_* key is unset
# or empty.
# ================================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
