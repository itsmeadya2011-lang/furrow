# Furrow Configuration
# Copy to .env and adjust as needed. All FURROW_ prefixed vars override these.

# LLM provider: "anthropic", "openai", or "ollama"
FURROW_PROVIDER=anthropic

# Default model (used when no specific model override is given)
FURROW_MODEL=claude-sonnet-4-20250514

# Model used by the planner subagent
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022

# Model used by the worker subagent
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022

# Model used by the tester subagent
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys (required for anthropic/openai providers)
FURROW_ANTHROPIC_API_KEY=
FURROW_OPENAI_API_KEY=

# Ollama settings (used when provider=ollama)
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Maximum number of parallel worker tasks per cycle
FURROW_MAX_PARALLEL_TASKS=5

# Maximum number of planning cycles (0 = unlimited)
FURROW_MAX_CYCLES=0

# Working directory for file operations
FURROW_WORKSPACE=.

# Log level: DEBUG, INFO, WARNING, ERROR
FURROW_LOG_LEVEL=INFO
