# Furrow environment configuration
# Copy this file to .env and uncomment/adjust the values you need.
# Furrow reads variables with the FURROW_ prefix via pydantic-settings.

# --- LLM provider selection -------------------------------------------------
# LLM provider: anthropic, openai, or ollama
# FURROW_PROVIDER=anthropic

# Default model used for completions/chat (planner/worker/tester fall back to
# their own model settings below).
# FURROW_MODEL=claude-sonnet-4-20250514

# Per-agent model overrides
# FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022
# FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022
# FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys (set at least one for your chosen provider)
# FURROW_ANTHROPIC_API_KEY=sk-ant-...
# FURROW_OPENAI_API_KEY=sk-...
# FURROW_OLLAMA_BASE_URL=http://localhost:11434

# --- Run limits -------------------------------------------------------------
# Maximum concurrent worker tasks per wave (>= 1)
# FURROW_MAX_PARALLEL_TASKS=5

# Maximum cycles (0 = unlimited); negative values are rejected
# FURROW_MAX_CYCLES=0

# Maximum tool-call iterations per worker task (>= 1)
# FURROW_MAX_WORKER_ITERATIONS=12

# Retry attempts for transient LLM errors (>= 0)
# FURROW_MAX_RETRIES=3

# Times a failed task is retried before it is marked failed (>= 0)
# FURROW_MAX_TASK_RETRIES=1

# Timeout in seconds for a single LLM request (> 0)
# FURROW_REQUEST_TIMEOUT=120.0

# Timeout in seconds for a worker command (> 0)
# FURROW_COMMAND_TIMEOUT=300.0

# Timeout in seconds for the test suite (> 0)
# FURROW_TEST_TIMEOUT=600.0

# Maximum tokens per LLM completion (>= 1)
# FURROW_MAX_TOKENS=4096

# --- Logging and state ------------------------------------------------------
# Logging level used by the CLI
# FURROW_LOG_LEVEL=INFO

# Path of the run-state file (relative to the workspace)
# FURROW_STATE_FILE=.furrow/state.json

# Working directory for the agent (defaults to the current directory)
# FURROW_WORKSPACE=

# --- Cost estimation --------------------------------------------------------
# Optional price overrides (USD per 1,000,000 tokens) as a JSON object mapping
# model ids to { "input_per_million": ..., "output_per_million": ... }.
# These take precedence over the built-in pricing table.
# FURROW_MODEL_PRICING='{"my-model":{"input_per_million":1.0,"output_per_million":2.0}}'
