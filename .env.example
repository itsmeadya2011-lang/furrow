# Furrow configuration (copy to .env and edit as needed)

# LLM provider: anthropic | openai | ollama
FURROW_PROVIDER=anthropic

# Default model (used when agent-specific models are not set)
FURROW_MODEL=claude-sonnet-4-20250514

# Per-agent model overrides
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys (required for anthropic/openai providers)
FURROW_ANTHROPIC_API_KEY=
FURROW_OPENAI_API_KEY=

# Ollama base URL (used when FURROW_PROVIDER=ollama)
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Max tasks to run in parallel
FURROW_MAX_PARALLEL_TASKS=5

# Max cycles before stopping (0 = unlimited)
FURROW_MAX_CYCLES=0

# Working directory for file operations
# FURROW_WORKSPACE=.

# Log level: DEBUG | INFO | WARNING | ERROR
FURROW_LOG_LEVEL=INFO