# LLM provider to use for completions (anthropic, openai, ollama)
FURROW_PROVIDER=anthropic

# Default LLM model for general completions
FURROW_MODEL=claude-sonnet-4-20250514

# Model used by the planner agent
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022

# Model used by the worker agent
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022

# Model used by the tester agent
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# Anthropic API key (required when provider is anthropic)
FURROW_ANTHROPIC_API_KEY=

# OpenAI API key (required when provider is openai)
FURROW_OPENAI_API_KEY=

# Base URL for Ollama server (used when provider is ollama)
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Maximum number of tasks to run in parallel
FURROW_MAX_PARALLEL_TASKS=5

# Maximum number of development cycles (0 for unlimited)
FURROW_MAX_CYCLES=0

# Workspace directory for Furrow operations
FURROW_WORKSPACE=

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
FURROW_LOG_LEVEL=INFO
