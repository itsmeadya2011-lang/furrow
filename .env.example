# Furrow configuration
# Copy to .env and adjust as needed. Environment variables use the FURROW_ prefix.

# LLM provider: anthropic, openai, or ollama
# FURROW_PROVIDER=anthropic

# Default and per-agent models
# FURROW_MODEL=claude-sonnet-4-20250514
# FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022
# FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022
# FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys / provider settings
# FURROW_ANTHROPIC_API_KEY=
# FURROW_OPENAI_API_KEY=
# FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Orchestration limits
# FURROW_MAX_PARALLEL_TASKS=5
# FURROW_MAX_CYCLES=0            # 0 = unlimited
# FURROW_MAX_WORKER_ITERATIONS=12
# FURROW_MAX_RETRIES=3           # transient LLM error retries
# FURROW_MAX_TASK_RETRIES=1      # retries for a failed task before marking failed

# Timeouts and generation limits
# FURROW_REQUEST_TIMEOUT=120.0   # LLM API request timeout (seconds)
# FURROW_COMMAND_TIMEOUT=300.0   # worker shell command timeout (seconds)
# FURROW_TEST_TIMEOUT=600.0      # test suite timeout (seconds)
# FURROW_MAX_TOKENS=4096

# Paths and logging
# FURROW_WORKSPACE=.             # project directory to work in
# FURROW_STATE_FILE=.furrow/state.json
# FURROW_LOG_LEVEL=INFO

# Optional: override model pricing (JSON object mapping model id to
# {"input_per_million": <usd>, "output_per_million": <usd>})
# FURROW_MODEL_PRICING={}
