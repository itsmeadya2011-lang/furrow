# === Furrow Environment Configuration ===

# LLM Provider: anthropic, openai, or ollama
FURROW_PROVIDER=anthropic

# Model names (used for general completion)
FURROW_MODEL=claude-sonnet-4-20250514

# Specialized models for each agent role
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys (at least one required depending on provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama settings (only needed if FURROW_PROVIDER=ollama)
FURROW_OLLAMA_BASE_URL=http://localhost:11434
FURROW_OLLAMA_MODEL=llama3.1

# Execution limits
FURROW_MAX_PARALLEL_TASKS=5
# 0 = unlimited cycles, set to a number to cap
FURROW_MAX_CYCLES=0

# Workspace and state
FURROW_WORKSPACE=.
FURROW_STATE_FILE=.furrow-state.json

# Logging
FURROW_LOG_LEVEL=INFO
