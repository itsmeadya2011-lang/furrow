# Furrow configuration — copy to .env and fill in your values.
#
# Every setting may also be set as an environment variable with the FURROW_
# prefix (e.g. FURROW_PROVIDER=openai). The .env file is read in addition to
# the environment, with the environment taking precedence.

# LLM provider: anthropic | openai | ollama
FURROW_PROVIDER=anthropic

# Default model used for chat/completions when no per-agent override is set.
FURROW_MODEL=claude-sonnet-4-20250514

# Per-agent model overrides.
FURROW_PLANNER_MODEL=claude-3-5-haiku-20241022
FURROW_WORKER_MODEL=claude-3-5-sonnet-20241022
FURROW_TESTER_MODEL=claude-3-5-sonnet-20241022

# API keys — only the one matching FURROW_PROVIDER is required.
FURROW_ANTHROPIC_API_KEY=
FURROW_OPENAI_API_KEY=

# Ollama OpenAI-compatible base URL (only used when FURROW_PROVIDER=ollama).
FURROW_OLLAMA_BASE_URL=http://localhost:11434

# Maximum concurrent worker tasks per dependency wave (>= 1).
FURROW_MAX_PARALLEL_TASKS=5

# Maximum cycles to run (0 = unlimited).
FURROW_MAX_CYCLES=0

# Maximum tool-call iterations per worker task (>= 1).
FURROW_MAX_WORKER_ITERATIONS=12

# Retry attempts for transient LLM errors (>= 0).
FURROW_MAX_RETRIES=3

# Times a failed task is retried before it is marked failed (>= 0).
FURROW_MAX_TASK_RETRIES=1

# Logging level used by the CLI at startup.
FURROW_LOG_LEVEL=INFO

# Request timeout in seconds (> 0).
FURROW_REQUEST_TIMEOUT=120.0

# Max tokens for LLM completions (>= 1).
FURROW_MAX_TOKENS=4096

# Command timeout for worker commands in seconds (> 0).
FURROW_COMMAND_TIMEOUT=300.0

# Test suite timeout in seconds (> 0).
FURROW_TEST_TIMEOUT=600.0

# State file path, relative to the workspace.
FURROW_STATE_FILE=.furrow/state.json

# Working directory for the agent (defaults to the current directory).
# FURROW_WORKSPACE=

# Optional per-model USD pricing overrides (JSON object).
# Each value is {"input_per_million": <float>, "output_per_million": <float>}.
# Example:
# FURROW_MODEL_PRICING='{"my-model":{"input_per_million":1.0,"output_per_million":2.0}}'