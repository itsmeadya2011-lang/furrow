# Byte-compiled / optimized files
# Regenerated on every interpreter run; committing them makes diffs unreadable
# and can shadow a stale .pyc after a branch switch.
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
# The repo-local .venv/ is ~100MB of site-packages. Without this rule a single
# `git add -A` commits the entire interpreter.
.venv/
venv/
env/

# Local secrets / env overrides
# Real .env files hold API keys and must stay untracked; the example is checked in.
.env
.env.*
!.env.example

# Python packaging artifacts
# Generated by `pip wheel` / `python -m build` and reproducible from pyproject.
*.egg-info/
build/
dist/

# Tool caches
# pytest/ruff/mypy write machine-local state that is pure noise in a diff.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Native extension modules
# Compiled per-platform and per-Python-version; wheels are built from source.
*.so