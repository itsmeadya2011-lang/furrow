# --- Secrets and local environment ------------------------------------------
# furrow/config.py sets env_file=".env", so pydantic-settings loads a .env from
# the working directory. That is where a developer's ANTHROPIC_API_KEY /
# OPENAI_API_KEY usually lives, so keep it out of git and commit only a
# .env.example template.
.env
.env.*
!.env.example

# --- Python bytecode --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# --- Packaging and build artefacts -----------------------------------------
*.egg-info/
build/
dist/
.eggs/

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
env/

# --- Test and static-analysis caches ----------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Coverage ---------------------------------------------------------------
.coverage
coverage.xml
htmlcov/

# --- Editor and OS noise ----------------------------------------------------
.idea/
.vscode/
.DS_Store