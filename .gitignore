# Byte-compiled / optimised files. Generated, never source: committing these
# ships stale bytecode and buries real diffs under .pyc churn.
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging output. `build/` in particular holds a stale
# `build/lib/furrow/**` copy of the package that drifts from `furrow/`.
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Environments and secrets.
.env
.env.*
.venv/
venv/
env/

# Tool caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editor / OS noise.
.idea/
.vscode/
*.swp
.DS_Store