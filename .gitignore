.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.dmypy.json

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Editors and OS cruft
.idea/
.vscode/
.DS_Store
Thumbs.db

# Node artifacts (kept in sync with .kilo/.gitignore)
node_modules/
.kilo/node_modules/
*.log